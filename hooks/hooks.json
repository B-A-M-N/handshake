{
  "description": "Handshake hooks — monitor maintains state, hooks inject state, commands expose state.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/precompact-check.sh\" 2>> \"${CLAUDE_PROJECT_DIR:-.}/.claude/handshake/hook-errors.log\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/userprompt-resume.sh\" 2>> \"${CLAUDE_PROJECT_DIR:-.}/.claude/handshake/hook-errors.log\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-hook.sh\" 2>> \"${CLAUDE_PROJECT_DIR:-.}/.claude/handshake/hook-errors.log\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/sessionend-finalize.sh\" 2>> \"${CLAUDE_PROJECT_DIR:-.}/.claude/handshake/hook-errors.log\""
          }
        ]
      }
    ]
  }
}
